---
import ConceptBanner from "./ConceptBanner.tsx";
import Contact from "./Contact.tsx";
import Differentials from "./Differentials.tsx";
import Experience from "./Experience.tsx";
import FAQ from "./FAQ.tsx";
import Footer from "./Footer.tsx";
import Gallery from "./Gallery.tsx";
import Hero from "./Hero.tsx";
import Manifesto from "./Manifesto.tsx";
import Navbar from "./Navbar.tsx";
import Process from "./Process.tsx";
import ScrollProgress from "./ScrollProgress.tsx";
import Services from "./Services.tsx";
import SmoothScroll from "./SmoothScroll.astro";
import Testimonials from "./Testimonials.tsx";
---

<SmoothScroll />

<ConceptBanner client:load />
<ScrollProgress client:load />
<Navbar client:load />

<main id="conteudo">
  <Hero client:load />
  <Manifesto client:visible />
  <Services client:visible />
  <Differentials client:visible />
  <Experience client:visible />
  <Process client:visible />
  <Gallery client:visible />
  <Testimonials client:visible />
  <FAQ client:visible />
  <Contact client:visible />
</main>

<Footer client:visible />

<style is:global>
  :root {
    /* Paleta — espresso editorial com brass */
    --color-canvas: #F4EFE6;
    --color-canvas-warm: #EDE5D6;
    --color-surface: #FFFFFF;
    --color-surface-elevated: #FBF7F0;
    --color-ink: #1F1712;
    --color-ink-soft: #3A2D24;
    --color-text: #2A1F18;
    --color-text-muted: #6B5A4E;
    --color-border: #E2D6C4;
    --color-border-strong: #C9B89E;
    --color-accent: #B08247;
    --color-accent-deep: #8A6234;
    --color-accent-soft: #D9B98A;
    --color-espresso: #1A130E;
    --color-espresso-soft: #2A2018;
    --color-cream: #F4EFE6;

    /* Tipografia */
    --font-display: "Cormorant Garamond", "Playfair Display", Georgia, serif;
    --font-body: "Inter", system-ui, -apple-system, sans-serif;
    --font-detail: "Inter", system-ui, sans-serif;

    /* Raios */
    --radius-control: 999px;
    --radius-card: 18px;
    --radius-stage: 28px;

    /* Sombras */
    --shadow-subtle: 0 1px 2px rgba(31, 23, 18, 0.04), 0 8px 24px rgba(31, 23, 18, 0.06);
    --shadow-elevated: 0 2px 6px rgba(31, 23, 18, 0.06), 0 24px 60px rgba(31, 23, 18, 0.12);
    --shadow-card-hover: 0 4px 12px rgba(31, 23, 18, 0.08), 0 32px 80px rgba(31, 23, 18, 0.16);

    --focus-ring: 0 0 0 3px rgba(176, 130, 71, 0.4);
  }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    overflow-y: auto;
  }

  body {
    background-color: var(--color-canvas);
    color: var(--color-text);
    font-family: var(--font-body);
    font-feature-settings: "ss01", "cv01";
    overflow-x: clip;
    padding-top: 0 !important;
  }

  /* Tipografia display */
  .font-display {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .font-body {
    font-family: var(--font-body);
  }

  /* Textura sutil de papel no fundo */
  .paper-texture {
    background-image:
      radial-gradient(circle at 20% 30%, rgba(176, 130, 71, 0.04) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(138, 98, 52, 0.03) 0%, transparent 50%);
  }

  /* Selection */
  ::selection {
    background: var(--color-accent);
    color: #fff;
  }

  /* Focus visível global */
  a:focus-visible,
  button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 4px;
  }

  /* Cursor pointer em elementos clicáveis */
  a[href],
  button,
  [role="button"],
  summary,
  label[for] {
    cursor: pointer;
  }

  /* Scrollbar discreta */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: var(--color-canvas-warm);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: 999px;
    border: 2px solid var(--color-canvas-warm);
  }

  /* Underline animado reutilizável */
  .link-underline {
    position: relative;
  }
  .link-underline::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 1px;
    width: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .link-underline:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Container padrão */
  .container-x {
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  @media (min-width: 640px) {
    .container-x {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .container-x {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }

  /* Garante que mx-auto funcione corretamente sobre cascade layers do Tailwind */
  .mx-auto {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  /* Reduced motion — garantir conteúdo visível */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
    }
    /* Garante que elementos com opacity inicial 0 (framer-motion) sejam visíveis */
    [style*="opacity: 0"],
    [style*="opacity:0"] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
